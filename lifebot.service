[Unit]
Description=lifebot backend (PWA static + threads/groups/voiceprints/logs API)
Documentation=https://github.com/david/lifebot
After=network.target

[Service]
Type=simple
User=david
WorkingDirectory=/home/david/projects/lifebot
# Source nvm inline rather than hardcoding a version path: a login shell alone
# won't load nvm non-interactively, and pinning
# .nvm/versions/node/<version>/bin breaks silently on every Node upgrade.
# This follows whatever nvm's `default` alias points at.
ExecStart=/bin/bash -lc 'export NVM_DIR=$HOME/.nvm && . $NVM_DIR/nvm.sh && exec node server.cjs'
Environment=LIFEBOT_PORT=8003
Restart=always
RestartSec=2
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
